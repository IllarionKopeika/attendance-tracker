<div class="row justify-content-center">
  <div class="col">
    <div class="custom-form p-3">

      <h1 class="text-center text-primary mb-2">新课程</h1>

      <%= render "shared/errors", object: @course %>

      <%= form_with model: @course do |f| %>
        <div class="mb-2">
          <%= f.text_field :name, placeholder: "名称", class: "form-control" %>
        </div>

        <div class="mb-2">
          <%= f.collection_select :group_id, Group.all.map { |group| [ group.name, group.id ] }, :second, :first, { prompt: "班级" } , placeholder: "班级名称", class: "form-select" %>
        </div>

        <div class="mb-2">
          <%= f.number_field :lessons_count, placeholder: "课数", class: "form-control" %>
        </div>

        <%= f.submit "提交", class: "btn btn-primary w-100 mb-2" %>
      <% end %>

      <%= link_to "课程列表", courses_path, class: "btn btn-outline-primary w-100 mb-2" %>

    </div>
  </div>
</div>
