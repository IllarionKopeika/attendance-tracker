<div class="row justify-content-center">
  <div class="col">
    <div class="custom-form p-3">

      <h1 class="text-center text-primary mb-3">课程列表</h1>

      <table class="table table-secondary table-striped text-center custom-table">
        <thead>
          <tr class="table-dark">
            <th scope="col">名称</th>
            <th scope="col">班级</th>
            <th scope="col">课数</th>
          </tr>
        </thead>
        <tbody class="table-group-divider">
          <% @courses.each do |course| %>
            <tr>
              <td scope="row"><%= link_to course.name, course_path(course), class: "btn btn-link p-0" %></td>
              <td scope="row"><%= course.group.name %></td>
              <td scope="row"><%= course.lessons.size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= link_to "新课程", new_course_path, class: "btn btn-outline-primary w-100 mb-2" %>

    </div>
  </div>
</div>
