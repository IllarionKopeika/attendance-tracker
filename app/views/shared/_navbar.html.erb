<div class="container-fluid custom-navbar mb-5">
  <% if authenticated? %>
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h4 class="text-center text-primary ms-1 my-0">你好，<%= Current.user.name %>！</h4>
      </div>
      <div class="d-flex justify-content-end align-items-center">
        <p class="my-0"><%= Time.current %></p>
        <%= link_to root_path, class: "d-inline-flex align-items-center" do %>
          <i class="fa-solid fa-house fa-xl me-3"></i>
        <% end %>
        <i class="fa-solid fa-bars fa-xl mx-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight"></i>
      </div>

      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header d-flex justify-content-between align-items-center">
          <h4 class="text-center text-primary ms-1 my-0">你好，<%= Current.user.name %>！</h4>
          <i class="fa-solid fa-xmark fa-xl text-dark me-1" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></i>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-center p-5">
          <p class="text-center my-0">学生</p>
          <%= link_to "新生", new_student_path %>
          <%= link_to "学生列表", students_path, class: "mb-2" %>
          <p class="text-center my-0">班级</p>
          <%= link_to "新班级", new_student_path %>
          <%= link_to "班级列表", students_path, class: "mb-2" %>
          <%= link_to "退出", logout_path, data: { turbo_method: :delete }, class: "btn btn-secondary text-white" %>
        </div>
      </div>
    </div>

  <% else %>
    <h4 class="text-center text-primary m-0">欢迎光临</h4>
  <% end %>
</div>
