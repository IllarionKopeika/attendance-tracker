<div class="row justify-content-center">
  <div class="col">
    <div class="custom-form p-3">

      <h1 class="text-center text-primary mb-2">登录</h1>

      <%= form_with url: session_path do |f| %>
        <div class="mb-2">
          <%= f.email_field :email, placeholder: "账号", value: params[:email], class: "form-control" %>
        </div>

        <div class="position-relative mb-2" data-controller="password-visibility">
          <%= f.password_field :password, placeholder: "密码", class: "form-control pe-5", data: { password_visibility_target: "input" } %>
          <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" data-action="password-visibility#toggle" tabindex="-1">
            <i data-password-visibility-target="icon" class="eye-icon fa-solid fa-eye"></i>
          </button>
        </div>

        <%= f.submit "登录", class: "btn btn-primary w-100 mb-2" %>
      <% end %>

    </div>
  </div>
</div>
