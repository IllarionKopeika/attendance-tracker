<div class="row justify-content-center">
  <div class="col">
    <div class="custom-form p-3">

      <h1 class="text-center text-primary mb-2">新班级</h1>

      <%= render "shared/errors", object: @group %>

      <%= form_with model: @group do |f| %>
        <div class="mb-2">
          <%= f.text_field :name, placeholder: "名称", class: "form-control" %>
        </div>

        <%= f.submit "提交", class: "btn btn-primary w-100 mb-2" %>
      <% end %>

      <%= link_to "班级列表", groups_path, class: "btn btn-outline-primary w-100 mb-2" %>

    </div>
  </div>
</div>
