<div class="row justify-content-center">
  <div class="col">
    <div class="custom-form p-3">

      <h1 class="text-center text-primary mb-3">班级列表</h1>

      <table class="table table-secondary table-striped text-center custom-table">
        <thead>
          <tr class="table-dark">
            <th scope="col">名称</th>
            <th scope="col">人数</th>
          </tr>
        </thead>
        <tbody class="table-group-divider">
          <% @groups.each do |group| %>
            <tr>
              <td scope="row">
                <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#group-modal-<%= group.id %>">
                  <%= group.name %>
                </button>
              </td>
              <td scope="row"><%= group.students.size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= link_to "新班级", new_group_path, class: "btn btn-outline-primary w-100 mb-2" %>

    </div>
  </div>
</div>

<%= render "group_modal" %>
